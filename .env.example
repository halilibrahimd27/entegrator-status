# Placeholders only. `make env` writes a local .env with random secrets.
# The app refuses to start while any secret below is missing, shorter than
# 32 bytes, a placeholder, or equal to another key.

ENVIRONMENT=dev
LOG_LEVEL=INFO

# Used in the User-Agent: EntegratorStatus/<version> (+<PUBLIC_BASE_URL>/hakkinda/bot; <CONTACT_EMAIL>)
PUBLIC_BASE_URL=<PUBLIC_BASE_URL>
CONTACT_EMAIL=<CONTACT_EMAIL>

# One key, one purpose. Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_KEY=<SESSION_KEY>
TOKEN_HASH_KEY=<TOKEN_HASH_KEY>
WEBHOOK_SIGNING_KEY=<WEBHOOK_SIGNING_KEY>
INGEST_HMAC_KEY=<INGEST_HMAC_KEY>

POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
