# Placeholders only. `make env` writes a local .env with random secrets and dev values.
# The app refuses to start while any secret below is missing, shorter than
# 32 bytes, a placeholder, or equal to another key.

ENVIRONMENT=dev
LOG_LEVEL=INFO

# Used in the User-Agent: EntegratorStatus/<version> (+<PUBLIC_BASE_URL>/hakkinda/bot; <CONTACT_EMAIL>)
PUBLIC_BASE_URL=<PUBLIC_BASE_URL>
CONTACT_EMAIL=<CONTACT_EMAIL>

# One key, one purpose. Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_KEY=<SESSION_KEY>
TOKEN_HASH_KEY=<TOKEN_HASH_KEY>
WEBHOOK_SIGNING_KEY=<WEBHOOK_SIGNING_KEY>
INGEST_HMAC_KEY=<INGEST_HMAC_KEY>
TOTP_ENCRYPTION_KEY=<TOTP_ENCRYPTION_KEY>

POSTGRES_PASSWORD=<POSTGRES_PASSWORD>

# Prober. `make node` appends PROBE_NODE_ID, PROBE_NODE_TOKEN and PROBE_SIGNING_KEY.
# Optional: three stable public https URLs (comma separated) the node checks to tell
# its own network problems from provider outages. Empty disables the check.
PROBE_CONTROL_TARGETS=
# DATABASE_URL and REDIS_URL are set by compose.yml from the values above.

# Outgoing mail (sign-up verification, password reset, invitations).
MAIL_BACKEND=smtp
MAIL_FROM=<MAIL_FROM_ADDRESS>
SMTP_HOST=<SMTP_HOST>
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=<SMTP_USERNAME>
SMTP_PASSWORD=<SMTP_PASSWORD>
