# Production settings for compose.prod.yml. `make env-prod` writes .env from this file
# with fresh secrets. Fill in every <PLACEHOLDER> before starting the stack.
# The app refuses to start while a secret is missing, short, a placeholder or reused.

ENVIRONMENT=prod
LOG_LEVEL=INFO

# Image tag on GitHub Container Registry, e.g. 1.0.0 (see CHANGELOG.md).
ENTEGRATOR_VERSION=<VERSION>

# The site's host name (DNS A/AAAA records point at this server) and the address
# Let's Encrypt writes to about certificates.
DOMAIN=<DOMAIN>
ACME_EMAIL=<ACME_EMAIL>
PUBLIC_BASE_URL=https://<DOMAIN>
# Shown in the bot's User-Agent and on /hakkinda/bot; receives correction requests.
CONTACT_EMAIL=<CONTACT_EMAIL>

SESSION_KEY=<SESSION_KEY>
TOKEN_HASH_KEY=<TOKEN_HASH_KEY>
WEBHOOK_SIGNING_KEY=<WEBHOOK_SIGNING_KEY>
INGEST_HMAC_KEY=<INGEST_HMAC_KEY>
TOTP_ENCRYPTION_KEY=<TOTP_ENCRYPTION_KEY>
# Wraps every organization's credential key. Back it up apart from the database
# backups (docs/BACKUP.md): without it, stored credentials cannot be decrypted.
CREDENTIALS_MASTER_KEY=<CREDENTIALS_MASTER_KEY>

POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
REDIS_PASSWORD=<REDIS_PASSWORD>

MAIL_BACKEND=smtp
MAIL_FROM=<MAIL_FROM_ADDRESS>
SMTP_HOST=<SMTP_HOST>
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=<SMTP_USERNAME>
SMTP_PASSWORD=<SMTP_PASSWORD>

# false: the sign-up page refuses new accounts (existing accounts keep working).
SIGNUP_ENABLED=true

# Optional.
# ORG_MAX_SOURCES=300
# TELEGRAM_BOT_TOKEN=<TELEGRAM_BOT_TOKEN>
# TELEGRAM_BOT_USERNAME=<TELEGRAM_BOT_USERNAME>
# METRICS_TOKEN=<METRICS_TOKEN>
# PROBE_CONTROL_TARGETS=
